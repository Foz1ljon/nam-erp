# MongoDB ulanish satri
NUXT_MONGO_URI=mongodb://127.0.0.1:27017/nammotors
# Sessiya shifrlash kaliti (kamida 32 belgi)
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-32chars
# Birinchi ishga tushirishda demo ma'lumotlar (true/false)
NUXT_SEED_DEMO=true
# Birinchi admin paroli
NUXT_ADMIN_PASSWORD=admin123
# ERP'ning internetdagi https manzili (Instagram webhook/OAuth uchun). UI'da ham kiritish mumkin.
NUXT_PUBLIC_BASE_URL=
